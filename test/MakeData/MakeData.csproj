<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes Radiant Quests' small Kenshi data file (data\RadiantQuests.mod): the Guild Parcel item for courier quests, its look copied from a
       base-game item. Run test\make-data.ps1; the result is committed and build.ps1 installs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Meitou.Data"><HintPath>$(MeitouDir)\Meitou.Data.dll</HintPath></Reference>
    <Reference Include="Meitou.Core"><HintPath>$(MeitouDir)\Meitou.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
